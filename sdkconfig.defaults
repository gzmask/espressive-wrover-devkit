# Verified target and detected 4 MB Flash; no hardware writes are made by building.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP32_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_INT_WDT=y

# No PSRAM assumptions. Enable only after module/hardware confirmation.
# CONFIG_SPIRAM is not set
# Wi-Fi runtime is opt-in. No Bluetooth or network service is started by default.
# CONFIG_WIFI_SERVICE_ENABLE is not set
# CONFIG_BOARD_DISPLAY_ENABLE is not set

# New source default: single factory app spanning the former A/B region.
# OFFLINE ONLY until exact bootloader/table/app hashes and erase ranges are approved.
CONFIG_SINGLE_APP_USB_ENABLE=y
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.single.csv"
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set
# CONFIG_OTA_SERVICE_ENABLE is not set
# Keep ROM-selected supply; no SDK default 1.8->1.9V boost.
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_8V=y
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_9V=n
