# Station embeds a private WIFI_CREDENTIALS_FILE; values never enter sdkconfig.
CONFIG_WIFI_SERVICE_ENABLE=y
CONFIG_WIFI_SERVICE_CONNECT_ENABLE=y
CONFIG_WIFI_SERVICE_US_CONFIRMED=y
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set
# CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION is not set
# CONFIG_ESP_PHY_MULTIPLE_INIT_DATA_BIN is not set
# CONFIG_LWIP_DHCP_RESTORE_LAST_IP is not set
