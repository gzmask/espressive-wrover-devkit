# Proposed migration only; NOT permission to flash generated artifacts.
CONFIG_OTA_SERVICE_ENABLE=y
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Keep ROM-selected supply; do not introduce the SDK default1.8->1.9V boost.
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_8V=y
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_9V=n
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128
