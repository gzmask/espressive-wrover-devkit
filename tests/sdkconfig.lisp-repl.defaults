# OFFLINE EXPERIMENT ONLY: not a flash/OTA candidate or device-write permission.
CONFIG_LISP_REPL_ENABLE=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Layout follows sdkconfig.defaults (single USB) or a later legacy OTA profile.
# Neither is permission to migrate a device table.
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_8V=y
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_9V=n
